# App
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tili-db

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM="TILI App <noreply@example.com>"

# Admin seed
ADMIN_EMAIL=admin@tili.com
ADMIN_PASSWORD=Admin123!

# TILIBOT (Groq) - CRUD réel projets/tâches via tools
GROQ_API_KEY=your-groq-api-key
# Modèle avec tool calling (défaut: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
