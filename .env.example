# Application
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/tili-db

# JWT
# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different generated value for ADMIN_PASSWORD.
JWT_SECRET=replace-with-a-unique-random-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM="TILI App <noreply@example.com>"

# Initial administrator (required only when no admin account exists yet)
ADMIN_EMAIL=replace-with-your-admin-email
ADMIN_PASSWORD=replace-with-a-unique-random-admin-password

# TILIBOT (Groq)
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional model override:
# GROQ_MODEL=llama-3.3-70b-versatile

# Text-to-Speech with Edge TTS
# See GOOGLE_CLOUD_TTS_SETUP.md for setup notes.
